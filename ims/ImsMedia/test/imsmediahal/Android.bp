package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "TestImsMediaHal_sm7125",
    manifest: "AndroidManifest.xml",
    srcs: [
        "src/**/*.java",
    ],
    libs: [
        "android-support-annotations",
    ],
    static_libs: [
        "android.hardware.radio.ims.media-V2-java",
        "ImsMediaFramework_sm7125",
        "imsmedia-core_sm7125",
    ],
    optimize: {
        enabled: false,
    },
    dex_preopt: {
        enabled: false,
    },
    owner: "google",
    platform_apis: true,
    privileged: true,
    certificate: "platform",
}
