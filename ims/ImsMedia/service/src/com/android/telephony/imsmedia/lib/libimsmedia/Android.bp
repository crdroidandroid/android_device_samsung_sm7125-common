package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "libimsmedia_defaults_sm7125",
    cflags: [
        "-Wall",
    ],
    shared_libs: [
        "libmediautils",
    ],
    sanitize: {
        cfi: true,
        scs: true,
    },
}

cc_library_shared {
    name: "libimsmedia_sm7125",
    system_ext_specific: true,
    defaults: [
        "libimsmedia_defaults_sm7125",
    ],
    srcs: [
        "libimsmedia.cpp",
    ],
    static_libs: [
        "libimsmedia_audio_sm7125",
        "libimsmedia_config_sm7125",
        "libimsmedia_core_sm7125",
        "libimsmedia_protocol_sm7125",
    ],
    shared_libs: [
        "framework-permission-aidl-cpp",
        "libaaudio",
        "libandroid",
        "libandroid_runtime",
        "libbinder",
        "libcamera2ndk",
        "libcutils",
        "libjnigraphics",
        "liblog",
        "libmediandk",
        "libnativewindow",
        "libutils",
        "libmediautils",
    ],
}
