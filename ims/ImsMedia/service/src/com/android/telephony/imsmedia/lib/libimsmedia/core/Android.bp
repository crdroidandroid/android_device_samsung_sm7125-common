package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_headers {
    name: "libimsmedia_headers_sm7125",
    export_include_dirs: [
        "include",
        "include/nodes",
        "include/utils",
    ],
}

cc_library_headers {
    name: "libimsmedia_audio_headers_sm7125",
    export_include_dirs: [
        "include/audio",
        "include/audio/nodes",
    ],
}

cc_library_headers {
    name: "libimsmedia_video_headers_sm7125",
    export_include_dirs: [
        "include/video",
        "include/video/nodes",
        "include/video/android",
    ],
}

cc_library_headers {
    name: "libimsmedia_text_headers_sm7125",
    export_include_dirs: [
        "include/text",
        "include/text/nodes",
    ],
}

cc_library_headers {
    name: "libimsmedia_core_interface_headers_sm7125",
    export_include_dirs: [
        "interface/utils",
    ],
}

cc_defaults {
    name: "libimsmedia_shared_defaults_sm7125",
    cflags: [
    ],
    header_libs: [
    ],
    include_dirs: [
        "frameworks/native/include",
        "frameworks/native/libs/binder/include/binder",
        "frameworks/av/media",
    ],
}

cc_defaults {
    name: "libimsmedia_audio_defaults_sm7125",
    cflags: [
    ],
    header_libs: [
        "libimsmedia_headers_sm7125",
        "libimsmedia_audio_headers_sm7125",
        "libimsmedia_config_headers_sm7125",
    ],
}

cc_defaults {
    name: "libimsmedia_video_defaults_sm7125",
    cflags: [
    ],
    header_libs: [
        "libimsmedia_headers_sm7125",
        "libimsmedia_video_headers_sm7125",
        "libimsmedia_config_headers_sm7125",
    ],
    shared_libs: [
        "libnativewindow",
        "libcamera2ndk",
        "libandroid",
    ],
    include_dirs: [
        "frameworks/av/camera/ndk/include",
        "frameworks/av/include",
    ],
}

cc_defaults {
    name: "libimsmedia_text_defaults_sm7125",
    cflags: [
    ],
    header_libs: [
        "libimsmedia_headers_sm7125",
        "libimsmedia_text_headers_sm7125",
        "libimsmedia_config_headers_sm7125",
    ],
}

cc_library_static {
    name: "libimsmedia_core_sm7125",
    defaults: [
        "libimsmedia_defaults_sm7125",
        "libimsmedia_protocol_defaults_sm7125",
        "libimsmedia_shared_defaults_sm7125",
        "libimsmedia_audio_defaults_sm7125",
        "libimsmedia_video_defaults_sm7125",
        "libimsmedia_text_defaults_sm7125",
    ],
    srcs: [
        "**/*.cpp",
        ":libimsmedia_jni_srcs_sm7125",
    ],
    exclude_srcs: [
        "audio/android/*.cpp",
    ],
    local_include_dirs: [
        "include",
    ],
    include_dirs: [
        "frameworks/av/media/utils/include",
    ],
    header_libs: [
        "libimsmedia_android_audio_headers_sm7125",
        "libimsmedia_jni_headers_sm7125",
        "libimsmedia_protocol_interface_headers_sm7125",
    ],
    static_libs: [
        "libimsmedia_config_sm7125",
        "libimsmedia_protocol_sm7125",
    ],
    shared_libs: [
        "framework-permission-aidl-cpp",
        "libaaudio",
        "libandroid_runtime",
        "libbinder",
        "libcutils",
        "libjnigraphics",
        "liblog",
        "libmediandk",
        "libutils",
        "libmediautils",
    ],
}
