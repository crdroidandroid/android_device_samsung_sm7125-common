package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_library {
    name: "imsmedia-core_sm7125",
    srcs: [
        "src/**/*.java",
        "src/**/*.aidl",
    ],
    aidl: {
        include_dirs: [
            "device/samsung/sm7125-common/ims/ImsMedia/framework/src",
        ],
    },
    libs: [
        "android-support-annotations",
        "androidx.annotation_annotation",
        "keepanno-annotations",
    ],
    static_libs: [
        "android.hardware.radio.ims.media-V2-java",
        // TODO: move this to libs after API review
        "ImsMediaFramework_sm7125",
    ],
    platform_apis: true,
}

android_app {
    name: "ImsMediaService_sm7125",
    system_ext_specific: true,
    manifest: "AndroidManifest.xml",
    static_libs: [
        "imsmedia-core_sm7125",
    ],
    required: [
        "libimsmedia_sm7125",
    ],
    dex_preopt: {
        enabled: false,
    },
    asset_dirs: [
        "assets",
    ],

    privileged: true,
    certificate: "platform",
    platform_apis: true,
}
