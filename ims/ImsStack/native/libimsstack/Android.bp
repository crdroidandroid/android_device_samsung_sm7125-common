}

cc_library_shared {
    name: "libimsstack_sm7125",
    system_ext_specific: true,
    defaults: [
        "imsstack_native_defaults_sm7125",
        "imsstack_shared_libs_defaults_sm7125",
        "imsstack_tls_libs_defaults_sm7125",
    ],
    srcs: [
        "libimsstack.cpp",
    ],
    static_libs: [
        "libimsmedia_config_sm7125",
        "libimsstack-platform_sm7125",
        "libimsstack-protocol_sm7125",
        "libimsstack-config_sm7125",
        "libimsstack-engine_sm7125",
        "libimsstack-enabler_sm7125",
        "libimsstack-main_sm7125",
        "libimsstack-jni_sm7125",
    ],
}
