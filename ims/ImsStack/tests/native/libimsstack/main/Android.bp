package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "imsstack_native_test_main_defaults_sm7125",
    defaults: [
        "imsstack_native_test_defaults_sm7125",
    ],
    header_libs: [
        "libimsstack_config_headers_sm7125",
        "libimsstack_enabler_loader_headers_sm7125",
        "libimsstack_engine_headers_sm7125",
        "libimsstack_main_headers_sm7125",
        "libimsstack_platform_headers_sm7125",
        "libimsstack_protocol_headers_sm7125",
    ],
    static_libs: [
        "libimsstack-config_sm7125",
        "libimsstack-enabler_sm7125",
        "libimsstack-engine_sm7125",
        "libimsstack-main_sm7125",
        "libimsstack-platform_sm7125",
        "libimsstack-protocol_sm7125",
    ],
}

cc_test {
    name: "ImsStackNativeMainTests_sm7125",
    defaults: [
        "imsstack_native_test_main_defaults_sm7125",
    ],
    srcs: [
        "**/*.cpp",
    ],

    test_config: "ImsStackNativeMainTests.xml",
}
